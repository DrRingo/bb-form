  "bin": "bb-form.bat",
  "depends": [
    "babashka"
  ],
  "post_install": [
    "# Kiểm tra gum đã cài chưa",
    "if (-not (Get-Command gum -ErrorAction SilentlyContinue)) {",
    "  Write-Host '' ",
    "  Write-Host '⚠️  bb-form cần Charm Gum để hiển thị UI terminal.' -ForegroundColor Yellow",
    "  Write-Host '   Hãy cài gum bằng một trong các cách sau:' -ForegroundColor Yellow",
    "  Write-Host ''",
    "  Write-Host '   1) winget (khuyên dùng):' -ForegroundColor Cyan",
    "  Write-Host '      winget install charmbracelet.gum' -ForegroundColor White",
    "  Write-Host ''",
    "  Write-Host '   2) Tải trực tiếp từ GitHub Releases:' -ForegroundColor Cyan",
    "  Write-Host '      https://github.com/charmbracelet/gum/releases' -ForegroundColor White",
    "  Write-Host ''",
    "  Write-Host '   3) Go (nếu đã cài Go):' -ForegroundColor Cyan",
    "  Write-Host '      go install github.com/charmbracelet/gum@latest' -ForegroundColor White",
    "  Write-Host ''",
    "} else {",
    "  $gumVer = (gum --version 2>&1) -replace 'gum version ',''",
    "  Write-Host \"✅ gum $gumVer đã sẵn sàng.\" -ForegroundColor Green",
    "}"
  ],
  "checkver": {
    "github": "https://github.com/drringo/bb-form"
  },
  "autoupdate": {
    "url": "https://github.com/drringo/bb-form/releases/download/v$version/bb-form-windows-x86_64.zip",
    "hash": {
      "url": "https://github.com/drringo/bb-form/releases/download/v$version/checksums.txt",
      "regex": "([a-fA-F0-9]+)\\s+bb-form-windows-x86_64\\.zip"
    }
  },
  "notes": [
    "bb-form đã được cài đặt!",
    "",
    "⚠️  Nếu chưa cài gum, hãy chạy:",
    "    winget install charmbracelet.gum",
    "    hoặc tải từ: https://github.com/charmbracelet/gum/releases",
    "",
    "Dùng thử: bb-form form_sample.json"
  ]
